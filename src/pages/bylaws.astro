---
// src/pages/bylaws.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Bylaws - VidhyaMithra">
  <Header />
  <Navigation />

  <div class="content-wrapper" style="justify-content: center;">
    <main class="main-content" style="flex: 1; max-width: 1000px; width: 100%;">
      <!-- Page Title -->
      <div
        class="content-box"
        style="background-color: #e6f0fa; border-top: 4px solid var(--nic-blue); padding: 15px; text-align: center;"
      >
        <h2 style="margin: 0;">
          <span class="lang-ml ml-text" style="color: var(--nic-blue);"
            >സൊസൈറ്റി നിയമാവലി (Bylaws)</span
          >
          <span class="lang-en" style="color: var(--nic-blue);"
            >Society Bylaws</span
          >
        </h2>
      </div>

      <div
        class="content-box legal-document"
        style="padding: 30px; background: #fff;"
      >
        <!-- ================= MALAYALAM VERSION ================= -->
        <div
          class="lang-ml ml-text"
          style="line-height: 1.8; text-align: justify;"
        >
          <h3 class="chapter-title">അദ്ധ്യായം 1 – പ്രാരംഭം</h3>
          <p>
            <strong>ആർട്ടിക്കിൾ 1. സൊസൈറ്റിയുടെ പേര്:</strong> സൊസൈറ്റിയുടെ പേര് "വിദ്യാമിത്ര
            എഡ്യൂക്കേഷണൽ കോ-ഓപ്പറേറ്റീവ് സൊസൈറ്റി ലിമിറ്റഡ്" എന്നായിരിക്കും. ഇതിനെ
            തുടർന്ന് "സൊസൈറ്റി" എന്ന് വിളിക്കുന്നു.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 2. രജിസ്റ്റേർഡ് ഓഫീസ്:</strong> സൊസൈറ്റിയുടെ രജിസ്റ്റേർഡ്
            ഓഫീസ് കേരളത്തിലെ എറണാകുളം ജില്ലയിൽ _________________ എന്ന സ്ഥലത്ത് പ്രവർത്തിക്കുന്നതാണ്.
            പൊതുയോഗത്തിന്റെ തീരുമാനപ്രകാരം പ്രവർത്തന പരിധിക്കുള്ളിൽ എവിടെ വേണമെങ്കിലും
            ഓഫീസ് മാറ്റാവുന്നതാണ്.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 3. പ്രവർത്തന പരിധി:</strong> സൊസൈറ്റിയുടെ പ്രവർത്തന
            പരിധി തുടക്കത്തിൽ എറണാകുളം ജില്ല മുഴുവനായിരിക്കും. ഭാവിയിൽ പൊതുയോഗത്തിന്റെ
            തീരുമാനപ്രകാരം ഇത് വികസിപ്പിക്കാവുന്നതാണ്.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 4. സൊസൈറ്റിയുടെ സ്വഭാവം:</strong> വിദ്യാഭ്യാസം, നൈപുണ്യ
            വികസനം, സാങ്കേതിക മുന്നേറ്റം, അംഗങ്ങളുടെ സാമ്പത്തിക ക്ഷേമം എന്നിവ പ്രോത്സാഹിപ്പിക്കുന്നതിനായി
            സ്ഥാപിച്ചിട്ടുള്ള ഒരു വിദ്യാഭ്യാസ സഹകരണ സ്ഥാപനമായിരിക്കും ഈ സൊസൈറ്റി.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 5. കാലാവധി:</strong> ഈ നിയമാവലി പ്രകാരം പിരിച്ചുവിടുന്നത്
            വരെ സൊസൈറ്റിക്ക് തുടർച്ചയായ നിലനിൽപ്പ് ഉണ്ടായിരിക്കും.
          </p>

          <h3 class="chapter-title">
            അദ്ധ്യായം 2 – ദർശനം, ലക്ഷ്യം, ഉദ്ദേശ്യങ്ങൾ
          </h3>
          <p>
            <strong>ആർട്ടിക്കിൾ 6. ദർശനം:</strong> കേരളത്തിലുടനീളമുള്ള വിദ്യാർത്ഥികൾക്ക്
            പ്രാപ്യവും മിതമായ നിരക്കിലുള്ളതും സാങ്കേതികവിദ്യയിലധിഷ്ഠിതവുമായ പഠനാവസരങ്ങൾ
            നൽകുന്ന സമഗ്രമായ ഒരു വിദ്യാഭ്യാസ ആവാസവ്യവസ്ഥ സൃഷ്ടിക്കുക എന്നതാണ് സൊസൈറ്റിയുടെ
            ദർശനം.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 7. ലക്ഷ്യം:</strong> പഠിതാക്കളെ ശാക്തീകരിക്കുകയും
            അംഗങ്ങൾക്ക് സുസ്ഥിരമായ മൂല്യം സൃഷ്ടിക്കുകയും ചെയ്യുന്ന വിദ്യാഭ്യാസ സ്ഥാപനങ്ങൾ,
            കോച്ചിംഗ് സെന്ററുകൾ, ഡിജിറ്റൽ ലേണിംഗ് പ്ലാറ്റ്‌ഫോമുകൾ, നൂതന വിദ്യാഭ്യാസ
            സാങ്കേതികവിദ്യകൾ എന്നിവ സ്ഥാപിക്കുക.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 8. പ്രാഥമിക ഉദ്ദേശ്യങ്ങൾ:</strong> (a) സ്കൂളുകൾ, കോളേജുകൾ,
            വിദ്യാഭ്യാസ സ്ഥാപനങ്ങൾ എന്നിവ സ്ഥാപിക്കുകയും നടത്തുകയും ചെയ്യുക. (b) കോച്ചിംഗ്
            സെന്ററുകളും പരിശീലന അക്കാദമികളും സ്ഥാപിക്കുക. (c) വിദ്യാഭ്യാസ പിന്തുണയും
            മാർഗ്ഗനിർദ്ദേശവും നൽകുക. (d) നൈപുണ്യ വികസനവും പ്രോത്സാഹിപ്പിക്കുക.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 9. വിദ്യാഭ്യാസ സ്ഥാപനങ്ങൾ:</strong> സൊസൈറ്റിക്ക് സ്കൂളുകൾ,
            കോളേജുകൾ, ട്യൂഷൻ സെന്ററുകൾ, കോച്ചിംഗ് ഇൻസ്റ്റിറ്റ്യൂട്ടുകൾ, ലൈബ്രറികൾ,
            ലബോറട്ടറികൾ, ഗവേഷണ കേന്ദ്രങ്ങൾ എന്നിവ സ്ഥാപിക്കാനും കൈവശം വെക്കാനും നിയന്ത്രിക്കാനും
            സഹായിക്കാനും കഴിയും.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 10. ഡിജിറ്റൽ വിദ്യാഭ്യാസം:</strong> എഡ്യൂക്കേഷണൽ വെബ്
            ആപ്ലിക്കേഷനുകൾ, ഓൺലൈൻ ലേണിംഗ് സിസ്റ്റങ്ങൾ, ആൻഡ്രോയിഡ് അപ്ലിക്കേഷനുകൾ,
            ഐ.ഒ.എസ് (iOS) അപ്ലിക്കേഷനുകൾ തുടങ്ങിയവ വികസിപ്പിക്കാനും പരിപാലിക്കാനും
            കഴിയും.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 11. വിദ്യാഭ്യാസ സേവനങ്ങൾ:</strong> സെമിനാറുകൾ, ശിൽപശാലകൾ,
            പരിശീലന പരിപാടികൾ, കരിയർ ഗൈഡൻസ്, മത്സര പരീക്ഷാ കോച്ചിംഗ് എന്നിവ സൊസൈറ്റിക്ക്
            നടത്താം.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 12. വരുമാന പ്രവർത്തനങ്ങൾ:</strong> സബ്‌സ്‌ക്രിപ്‌ഷനുകൾ,
            ട്യൂഷൻ ഫീസ്, ലൈസൻസിംഗ്, പരസ്യം, സ്പോൺസർഷിപ്പുകൾ, ഡിജിറ്റൽ സേവനങ്ങൾ, പ്രസിദ്ധീകരണങ്ങൾ
            എന്നിവയിലൂടെ സൊസൈറ്റിക്ക് വരുമാനം ഉണ്ടാക്കാം.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 13. വിദ്യാർത്ഥി ക്ഷേമം:</strong> അർഹരായ വിദ്യാർത്ഥികൾക്ക്
            സ്കോളർഷിപ്പുകൾ, അവാർഡുകൾ, ഫെലോഷിപ്പുകൾ, ധനസഹായ പദ്ധതികൾ എന്നിവ സൊസൈറ്റിക്ക്
            ഏർപ്പെടുത്താം.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 14. ഗവേഷണവും നവീകരണവും:</strong> വിദ്യാഭ്യാസ-നൈപുണ്യ
            വികസന മേഖലകളിൽ ഗവേഷണം, നവീകരണം, സംരംഭകത്വം എന്നിവ പ്രോത്സാഹിപ്പിക്കാം.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 15. അനുബന്ധ പ്രവർത്തനങ്ങൾ:</strong> വിദ്യാഭ്യാസ ലക്ഷ്യങ്ങൾ
            പൂർത്തീകരിക്കുന്നതിന് ആവശ്യമായ എല്ലാ അനുബന്ധ പ്രവർത്തനങ്ങളും ഏറ്റെടുക്കാം.
          </p>

          <h3 class="chapter-title">അദ്ധ്യായം 3 – അംഗത്വം</h3>
          <p>
            <strong>ആർട്ടിക്കിൾ 16. അംഗത്വ യോഗ്യത:</strong> 18 വയസ്സ് പൂർത്തിയായതും
            സൊസൈറ്റിയുടെ ലക്ഷ്യങ്ങളെ പിന്തുണയ്ക്കുന്നതുമായ ഏതൊരു വ്യക്തിക്കും അംഗത്വത്തിന്
            അപേക്ഷിക്കാം. സ്ഥാപനങ്ങൾ, കമ്പനികൾ, ട്രസ്റ്റുകൾ എന്നിവയ്ക്ക് അർഹതയുണ്ടായിരിക്കില്ല.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 17. അംഗങ്ങളെ പ്രവേശിപ്പിക്കൽ:</strong> അപേക്ഷകർ നിശ്ചിത
            ഫോമിൽ പ്രവേശന ഫീസും കുറഞ്ഞത് ഒരു ഓഹരിയുടെ വിലയും സഹിതം അപേക്ഷ സമർപ്പിക്കണം.
            60 ദിവസത്തിനകം ഭരണസമിതി തീരുമാനമെടുക്കും.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 18. കുറഞ്ഞതും കൂടിയതുമായ ഓഹരി:</strong> ഓരോ അംഗവും
            2,500 രൂപ മുഖവിലയുള്ള കുറഞ്ഞത് ഒരു ഓഹരിയെങ്കിലും എടുത്തിരിക്കണം. ഒരാൾക്ക്
            പരമാവധി 100 ഓഹരികൾ വരെ മാത്രമേ എടുക്കാൻ പാടുള്ളൂ.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 19. അംഗങ്ങളുടെ അവകാശങ്ങൾ:</strong> (a) പൊതുയോഗത്തിൽ
            പങ്കെടുക്കാൻ. (b) ഒരു വോട്ട് രേഖപ്പെടുത്താൻ. (c) തിരഞ്ഞെടുപ്പിൽ മത്സരിക്കാൻ.
            (d) ലാഭവിഹിതം ലഭിക്കാൻ. (e) രേഖകൾ പരിശോധിക്കാൻ. (f) പ്രവർത്തനങ്ങളിൽ പങ്കെടുക്കാൻ.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 20. അംഗങ്ങളുടെ ചുമതലകൾ:</strong> നിയമാവലി പാലിക്കുക,
            ലക്ഷ്യങ്ങൾ പ്രോത്സാഹിപ്പിക്കുക, ആസ്തികൾ സംരക്ഷിക്കുക, സാമ്പത്തിക ബാധ്യതകൾ
            കൃത്യമായി നിറവേറ്റുക, ധാർമ്മികത പാലിക്കുക.
          </p>

          <h3 class="chapter-title">
            അദ്ധ്യായം 4 – ഓഹരി മൂലധനവും അംഗങ്ങളുടെ ബാധ്യതയും
          </h3>
          <p>
            <strong>ആർട്ടിക്കിൾ 21. അംഗീകൃത ഓഹരി മൂലധനം:</strong> സൊസൈറ്റിയുടെ അംഗീകൃത
            ഓഹരി മൂലധനം 25,00,000 രൂപയായിരിക്കും (2,500 രൂപയുടെ 1,000 ഓഹരികൾ).
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 22. ഓഹരി വിതരണം:</strong> നിയമാവലിക്കും ഭരണസമിതിയുടെ
            തീരുമാനങ്ങൾക്കും വിധേയമായി അർഹരായ വ്യക്തികൾക്ക് ഓഹരികൾ നൽകാം.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 23. ഷെയർ സർട്ടിഫിക്കറ്റുകൾ:</strong> ഓഹരി അനുവദിച്ച്
            90 ദിവസത്തിനകം പ്രസിഡന്റും സെക്രട്ടറിയും ഒപ്പിട്ട ഷെയർ സർട്ടിഫിക്കറ്റ്
            ലഭിക്കാൻ അംഗത്തിന് അവകാശമുണ്ട്.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 24. സംയുക്ത ഉടമസ്ഥത പാടില്ല:</strong> ഓഹരികൾ ഒന്നിലധികം
            പേർ ചേർന്ന് സംയുക്തമായി കൈവശം വയ്ക്കാൻ പാടില്ല.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 25. ഓഹരി കൈമാറ്റം:</strong> ഭരണസമിതിയുടെ മുൻകൂർ അനുമതിയോടെ
            അംഗങ്ങൾക്ക് തങ്ങളുടെ ഓഹരികൾ അർഹരായ മറ്റൊരംഗത്തിന് കൈമാറാം.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 26. നോമിനേഷൻ:</strong> മരണാനന്തരം ഓഹരികളുടെയും നിക്ഷേപങ്ങളുടെയും
            മൂല്യം ലഭിക്കുന്നതിനായി ഓരോ അംഗത്തിനും ഒരാളെ നോമിനിയായി നിയമിക്കാം.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 27. അംഗങ്ങളുടെ ബാധ്യത:</strong> അംഗങ്ങളുടെ ബാധ്യത
            അവർ എടുത്ത ഓഹരികളിൽ അടച്ചുതീർക്കാനുള്ള തുകയിൽ മാത്രം ഒതുങ്ങുന്നതായിരിക്കും
            (Limited Liability).
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 28. ഓഹരികൾ കണ്ടുകെട്ടൽ:</strong> തട്ടിപ്പ്, കുടിശ്ശിക
            വരുത്തൽ എന്നീ സാഹചര്യങ്ങളിൽ ഓഹരികൾ കണ്ടുകെട്ടാൻ സൊസൈറ്റിക്ക് അധികാരമുണ്ട്.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 29. ഓഹരികൾ തിരികെ നൽകൽ:</strong> സൊസൈറ്റിയിൽ നിന്ന്
            രാജി വയ്ക്കുന്ന അംഗത്തിന് ഓഹരികൾ തിരികെ നൽകാം. സാമ്പത്തിക സ്ഥിതിക്കനുസരിച്ച്
            സൊസൈറ്റി തുക മടക്കി നൽകുന്നതാണ്.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 30. ഷെയർ രജിസ്റ്റർ:</strong> അംഗങ്ങളുടെ പേര്, ഓഹരികളുടെ
            എണ്ണം, കൈമാറ്റങ്ങൾ എന്നിവ കാണിക്കുന്ന രജിസ്റ്റർ സൊസൈറ്റി സൂക്ഷിക്കേണ്ടതാണ്.
          </p>

          <h3 class="chapter-title">
            അദ്ധ്യായം 5 – നിക്ഷേപങ്ങൾ, വായ്പകൾ, ഫണ്ടുകൾ
          </h3>
          <p>
            <strong>ആർട്ടിക്കിൾ 31. നിക്ഷേപങ്ങൾ സ്വീകരിക്കൽ:</strong> അംഗങ്ങളിൽ നിന്ന്
            സേവിംഗ്സ്, ഫിക്സഡ് (FD), റിക്കറിംഗ് (RD), സ്പെഷ്യൽ ഡിപ്പോസിറ്റുകൾ സ്വീകരിക്കാം.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 32. വായ്പാ ഇനങ്ങൾ:</strong> വിദ്യാഭ്യാസ വായ്പകൾ, അടിയന്തര
            വായ്പകൾ, ബിസിനസ് ലോണുകൾ എന്നിവ നൽകാം.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 33. ലോൺ അപേക്ഷകൾ:</strong> ആവശ്യമായ രേഖകൾ സഹിതം നിശ്ചിത
            ഫോർമാറ്റിൽ അപേക്ഷ സമർപ്പിക്കണം.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 34. ലോൺ അംഗീകാരം:</strong> ഭരണസമിതിയോ അവർ ചുമതലപ്പെടുത്തുന്ന
            കമ്മിറ്റിയോ ലോണുകൾ പാസ്സാക്കുകയോ നിരസിക്കുകയോ ചെയ്യും.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 35. ജാമ്യം:</strong> വായ്പകൾക്ക് വ്യക്തിഗത ജാമ്യമോ
            വസ്തു ജാമ്യമോ സൊസൈറ്റി ആവശ്യപ്പെടാം.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 36. പലിശ നിരക്കുകൾ:</strong> വായ്പകൾക്കും നിക്ഷേപങ്ങൾക്കുമുള്ള
            പലിശ നിരക്കുകൾ ഭരണസമിതി കാലാകാലങ്ങളിൽ തീരുമാനിക്കും.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 37. വായ്പാ വീണ്ടെടുക്കൽ:</strong> കുടിശ്ശികയായ വായ്പകൾ
            തിരിച്ചുപിടിക്കാൻ നിയമനടപടികൾ ഉൾപ്പെടെയുള്ള നടപടികൾ സൊസൈറ്റി സ്വീകരിക്കും.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 38. റിസർവ് ഫണ്ട്:</strong> സാമ്പത്തിക സുസ്ഥിരതയ്ക്കും
            ഭാവി വികസനത്തിനുമായി ഒരു റിസർവ് ഫണ്ട് സൂക്ഷിക്കും.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 39. വിദ്യാഭ്യാസ വികസന ഫണ്ട്:</strong> വിദ്യാഭ്യാസ
            പ്രോജക്ടുകൾക്കും സാങ്കേതിക മുന്നേറ്റങ്ങൾക്കുമായി ഒരു വിദ്യാഭ്യാസ വികസന
            ഫണ്ട് രൂപീകരിക്കാം.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 40. വെൽഫെയർ ഫണ്ട്:</strong> അംഗങ്ങളുടെയും വിദ്യാർത്ഥികളുടെയും
            പ്രയോജനത്തിനായി ക്ഷേമ പദ്ധതികളും ഫണ്ടുകളും സ്ഥാപിക്കാം.
          </p>

          <h3 class="chapter-title">അദ്ധ്യായം 6 – വിദ്യാഭ്യാസ പ്രവർത്തനങ്ങൾ</h3>
          <p>
            <strong>ആർട്ടിക്കിൾ 41 മുതൽ 50 വരെ:</strong> സ്കൂളുകൾ, കോച്ചിംഗ് സെന്ററുകൾ,
            ട്യൂഷൻ സെന്ററുകൾ, ഓൺലൈൻ ലേണിംഗ് പ്ലാറ്റ്‌ഫോമുകൾ, വെബ് ആപ്പുകൾ, മൊബൈൽ ആപ്പുകൾ
            (Android/iOS), ഡിജിറ്റൽ കണ്ടന്റുകൾ, ലൈബ്രറികൾ, സ്കോളർഷിപ്പുകൾ, മറ്റ് വിദ്യാഭ്യാസ
            സ്ഥാപനങ്ങളുമായുള്ള സഹകരണം എന്നിവ സൊസൈറ്റിക്ക് സ്ഥാപിക്കാനും നിയന്ത്രിക്കാനും
            കഴിയും.
          </p>

          <h3 class="chapter-title">അദ്ധ്യായം 7 – പൊതുയോഗം (ജനറൽ ബോഡി)</h3>
          <p>
            <strong>ആർട്ടിക്കിൾ 51. പരമാധികാരം:</strong> സൊസൈറ്റിയുടെ പരമാധികാരം ജനറൽ
            ബോഡിയിൽ നിക്ഷിപ്തമായിരിക്കും.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 52. ഘടന:</strong> വോട്ടവകാശമുള്ള എല്ലാ അംഗങ്ങളും ഉൾപ്പെടുന്നതായിരിക്കും
            ജനറൽ ബോഡി.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 53. വാർഷിക പൊതുയോഗം:</strong> എല്ലാ സാമ്പത്തിക വർഷവും
            ഒരു വാർഷിക പൊതുയോഗം (AGM) വിളിച്ചുചേർക്കേണ്ടതാണ്.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 54. പ്രത്യേക പൊതുയോഗം:</strong> ബോർഡിന്റെ തീരുമാനപ്രകാരമോ,
            അല്ലെങ്കിൽ അഞ്ചിലൊന്ന് അംഗങ്ങളുടെ രേഖാമൂലമുള്ള ആവശ്യപ്രകാരമോ പ്രത്യേക
            യോഗം വിളിക്കാം.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 55. നോട്ടീസ്:</strong> പൊതുയോഗത്തിന് കുറഞ്ഞത് 15 ദിവസത്തെ
            നോട്ടീസ് നൽകിയിരിക്കണം.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 56. ക്വാറം:</strong> മൊത്തം അംഗങ്ങളുടെ മൂന്നിലൊന്ന്
            അല്ലെങ്കിൽ 50 അംഗങ്ങൾ (ഏതാണോ കുറവ് അത്) ക്വാറമായി കണക്കാക്കും.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 57. വോട്ടവകാശം:</strong> ഓഹരികളുടെ എണ്ണം പരിഗണിക്കാതെ
            ഓരോ അംഗത്തിനും ഒരു വോട്ട് മാത്രമേ ഉണ്ടായിരിക്കൂ.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 58. അധികാരങ്ങൾ:</strong> കണക്കുകൾ പാസ്സാക്കൽ, ഡയറക്ടർമാരെ
            തിരഞ്ഞെടുക്കൽ, നിയമാവലി ഭേദഗതി, ലാഭവിഹിതം പ്രഖ്യാപിക്കൽ എന്നിവയ്ക്കുള്ള
            അധികാരം.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 59 & 60:</strong> യോഗത്തിന്റെ മിനുട്സ് ശാശ്വതമായി
            സൂക്ഷിക്കണം. തീരുമാനങ്ങൾ ലളിതമായ ഭൂരിപക്ഷത്തിൽ പാസ്സാക്കാം.
          </p>

          <h3 class="chapter-title">
            അദ്ധ്യായം 8 – ഭരണസമിതി (ബോർഡ് ഓഫ് ഡയറക്ടേഴ്സ്)
          </h3>
          <p>
            <strong>ആർട്ടിക്കിൾ 61. ഭരണസമിതിയുടെ ഘടന:</strong> പൊതുയോഗം തിരഞ്ഞെടുക്കുന്ന
            9 ഡയറക്ടർമാർ അടങ്ങുന്ന ബോർഡ് സൊസൈറ്റിയുടെ ഭരണം നടത്തും.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 62. കാലാവധി:</strong> ഭരണസമിതിയുടെ കാലാവധി സ്ഥാനമേറ്റെടുക്കുന്ന
            തീയതി മുതൽ 5 വർഷമായിരിക്കും.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 63. യോഗ്യത:</strong> സാമ്പത്തിക ബാധ്യതകൾ കൃത്യമായി
            നിറവേറ്റുന്ന അംഗങ്ങൾക്ക് മാത്രമേ തിരഞ്ഞെടുപ്പിൽ മത്സരിക്കാൻ യോഗ്യതയുണ്ടാവൂ.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 64. അയോഗ്യത:</strong> പാപ്പരാവുകയോ, ക്രിമിനൽ കുറ്റത്തിന്
            ശിക്ഷിക്കപ്പെടുകയോ, സൊസൈറ്റിയുടെ താൽപര്യങ്ങൾക്ക് വിരുദ്ധമായി പ്രവർത്തിക്കുകയോ
            ചെയ്താൽ അയോഗ്യനാക്കപ്പെടും.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 65 മുതൽ 70 വരെ:</strong> സുതാര്യമായ രീതിയിലായിരിക്കും
            തിരഞ്ഞെടുപ്പ്. ആദ്യ ഭരണസമിതി പ്രൊമോട്ടർമാരായിരിക്കും. ഭരണത്തിന് ആവശ്യമായ
            എല്ലാ അധികാരങ്ങളും ബോർഡിനുണ്ട്. രണ്ട് മാസത്തിലൊരിക്കൽ യോഗം ചേരണം. നോട്ടീസ്
            7 ദിവസം മുമ്പ് നൽകണം. 5 ഡയറക്ടർമാരുണ്ടെങ്കിൽ ക്വാറം തികയും.
          </p>

          <h3 class="chapter-title">അദ്ധ്യായം 9 – ഭാരവാഹികൾ</h3>
          <p>
            <strong>ആർട്ടിക്കിൾ 71 മുതൽ 80 വരെ:</strong> ബോർഡ് സ്വന്തം അംഗങ്ങളിൽ നിന്ന്
            ഒരു പ്രസിഡന്റിനെയും വൈസ് പ്രസിഡന്റിനെയും തിരഞ്ഞെടുക്കും. റെക്കോർഡുകൾ സൂക്ഷിക്കാൻ
            സെക്രട്ടറിയെയും സാമ്പത്തിക കാര്യങ്ങൾക്കായി ട്രഷററെയും നിയമിക്കും. പ്രസിഡന്റ്
            യോഗങ്ങളിൽ അധ്യക്ഷത വഹിക്കും. മൂന്നിൽ രണ്ട് ഭൂരിപക്ഷത്തോടെ ഭാരവാഹികളെ നീക്കം
            ചെയ്യാം. ഒഴിവുകൾ ബോർഡിന് നികത്താം.
          </p>

          <h3 class="chapter-title">അദ്ധ്യായം 10 – കമ്മിറ്റികൾ</h3>
          <p>
            <strong>ആർട്ടിക്കിൾ 81 മുതൽ 90 വരെ:</strong> ഫിനാൻസ്, എഡ്യൂക്കേഷൻ, ടെക്നോളജി,
            ലോൺ, ഓഡിറ്റ്, അഡ്വൈസറി എന്നീ കമ്മിറ്റികൾ ഭരണസമിതിക്ക് രൂപീകരിക്കാം. ഇവ
            ഭരണസമിതിയുടെ നിയന്ത്രണത്തിൽ പ്രവർത്തിക്കുകയും റിപ്പോർട്ടുകൾ സമർപ്പിക്കുകയും
            വേണം.
          </p>

          <h3 class="chapter-title">അദ്ധ്യായം 11 – ജീവനക്കാരും ഭരണനിർവഹണവും</h3>
          <p>
            <strong>ആർട്ടിക്കിൾ 91 മുതൽ 95 വരെ:</strong> അധ്യാപകർ, സാങ്കേതിക വിദഗ്ധർ,
            അഡ്മിനിസ്ട്രേറ്റീവ് സ്റ്റാഫ് എന്നിവരെ സൊസൈറ്റിക്ക് നിയമിക്കാം. യോഗ്യതയും
            ശമ്പളവും ബോർഡ് തീരുമാനിക്കും. ജീവനക്കാർ അച്ചടക്കം പാലിക്കണം, അല്ലാത്തപക്ഷം
            ബോർഡിന് സസ്പെൻഡ് ചെയ്യാനോ പിരിച്ചുവിടാനോ അധികാരമുണ്ട്.
          </p>

          <h3 class="chapter-title">
            അദ്ധ്യായം 12 – കണക്കുകൾ, മിച്ചത്തുക, ലാഭവിഹിതം
          </h3>
          <p>
            <strong>ആർട്ടിക്കിൾ 96. കണക്കുപുസ്തകങ്ങൾ:</strong> കൃത്യമായ കണക്കുപുസ്തകങ്ങൾ
            സൂക്ഷിക്കേണ്ടതാണ്.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 97. സാമ്പത്തിക വർഷം:</strong> ഏപ്രിൽ 1 മുതൽ മാർച്ച്
            31 വരെയായിരിക്കും സാമ്പത്തിക വർഷം.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 98. ഓഡിറ്റ്:</strong> വർഷാവർഷം കണക്കുകൾ ഓഡിറ്റ് ചെയ്യേണ്ടതാണ്.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 99. മിച്ചത്തുക വകയിരുത്തൽ:</strong> ലാഭവിഹിതം പ്രഖ്യാപിക്കുന്നതിന്
            മുമ്പ് റിസർവ്, വെൽഫെയർ ഫണ്ടുകളിലേക്ക് തുക മാറ്റണം.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 100. ലാഭവിഹിത വിതരണം:</strong> എല്ലാ നിയമപരമായ മാറ്റിവെക്കലുകൾക്കും
            ശേഷം, അംഗങ്ങൾക്ക് എല്ലാ നാല് മാസത്തിലും ഒരിക്കൽ തുല്യ ശതമാനത്തിൽ ലാഭവിഹിതം
            പ്രഖ്യാപിക്കുകയും വിതരണം ചെയ്യുകയും ചെയ്യാവുന്നതാണ്.
          </p>

          <h3 class="chapter-title">
            അദ്ധ്യായം 13 – തർക്കങ്ങൾ, ഭേദഗതികൾ, പിരിച്ചുവിടൽ
          </h3>
          <p>
            <strong>ആർട്ടിക്കിൾ 101 & 102. തർക്കപരിഹാരം:</strong> തർക്കങ്ങൾ ആദ്യം
            മധ്യസ്ഥതയിലൂടെയും പിന്നീട് ആർബിട്രേഷനിലൂടെയും പരിഹരിക്കേണ്ടതാണ്.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 103 മുതൽ 106 വരെ. ഭേദഗതികൾ:</strong> പൊതുയോഗ പ്രമേയത്തിലൂടെ
            മാത്രമേ നിയമാവലി ഭേദഗതി ചെയ്യാവൂ. ഇതിന് മൂന്നിൽ രണ്ട് ഭൂരിപക്ഷം ആവശ്യമാണ്.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 107. ഔദ്യോഗിക മുദ്ര:</strong> സൊസൈറ്റിക്ക് സ്വന്തമായി
            ഒരു ഔദ്യോഗിക മുദ്ര (Common Seal) ഉണ്ടായിരിക്കും.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 108 & 109. പിരിച്ചുവിടൽ:</strong> നിയമപ്രകാരം ജനറൽ
            ബോഡിയുടെ പ്രമേയത്തിലൂടെ മാത്രമേ സൊസൈറ്റി പിരിച്ചുവിടാൻ പാടുള്ളൂ. ബാധ്യതകൾ
            തീർത്ത ശേഷം ബാക്കിയുള്ള ആസ്തികൾ നിയമപരമായി കൈമാറേണ്ടതാണ്.
          </p>
          <p>
            <strong>ആർട്ടിക്കിൾ 110. ഇടക്കാല വ്യവസ്ഥ:</strong> തിരഞ്ഞെടുക്കപ്പെട്ട
            ആദ്യ ബോർഡ് അധികാരമേൽക്കുന്നത് വരെ പ്രൊമോട്ടർ ബോർഡ് ഭരണം തുടരുന്നതാണ്.
          </p>
        </div>

        <!-- ================= ENGLISH VERSION ================= -->
        <div class="lang-en" style="line-height: 1.8; text-align: justify;">
          <h3 class="chapter-title">CHAPTER I – PRELIMINARY</h3>
          <p>
            <strong>Article 1. Name of the Society:</strong> The name of the society
            shall be "VidhyaMithra Educational Co-operative Society Limited", hereinafter
            referred to as "the Society".
          </p>
          <p>
            <strong>Article 2. Registered Office:</strong> The registered office of
            the Society shall be situated at: __________________ within Ernakulam
            District, Kerala, and may be shifted within the area of operation by a
            resolution of the General Body.
          </p>
          <p>
            <strong>Article 3. Area of Operation:</strong> The area of operation of
            the Society shall initially extend to the entire district of Ernakulam
            and may be expanded in the future by resolution of the General Body.
          </p>
          <p>
            <strong>Article 4. Nature of the Society:</strong> The Society shall be
            an educational cooperative institution established for the promotion of
            education, skill development, technological advancement and the economic
            welfare of its members.
          </p>
          <p>
            <strong>Article 5. Duration:</strong> The Society shall have perpetual
            succession and shall continue to exist until dissolved in accordance with
            these bylaws.
          </p>

          <h3 class="chapter-title">
            CHAPTER II – VISION, MISSION AND OBJECTIVES
          </h3>
          <p>
            <strong>Article 6. Vision:</strong> To create a comprehensive educational
            ecosystem that provides accessible, affordable and technology-enabled
            learning opportunities to students across Kerala.
          </p>
          <p>
            <strong>Article 7. Mission:</strong> To establish educational institutions,
            coaching centres, digital learning platforms and innovative educational
            technologies that empower learners and generate sustainable value for
            members.
          </p>
          <p>
            <strong>Article 8. Primary Objects:</strong> (a) To establish schools
            and colleges. (b) To establish coaching centres. (c) To provide educational
            support. (d) To promote skill development.
          </p>
          <p>
            <strong>Articles 9 - 15:</strong> The Society may establish educational
            institutions, develop digital education apps (Android/iOS), conduct seminars,
            generate revenue through subscriptions and ads, institute scholarships,
            promote research, and undertake all ancillary activities.
          </p>

          <h3 class="chapter-title">CHAPTER III – MEMBERSHIP</h3>
          <p>
            <strong>Article 16. Eligibility:</strong> Any individual who has attained
            the age of 18 years and supports the objectives of the Society may apply.
            Institutions and companies are not eligible.
          </p>
          <p>
            <strong>Article 17. Admission:</strong> Applications must be submitted
            with the entrance fee and value of at least one share. The Board shall
            decide within 60 days.
          </p>
          <p>
            <strong>Article 18. Shareholding:</strong> Every member shall hold at
            least one share of ₹2,500. No member shall hold more than 100 shares.
          </p>
          <p>
            <strong>Article 19. Rights:</strong> To attend General Body meetings,
            exercise one vote, contest elections, receive dividends, inspect records,
            and participate in activities.
          </p>
          <p>
            <strong>Article 20. Duties:</strong> Observe bylaws, promote objectives,
            protect assets, fulfil financial obligations, and maintain ethical conduct.
          </p>

          <h3 class="chapter-title">
            CHAPTER IV – SHARE CAPITAL AND MEMBER LIABILITY
          </h3>
          <p>
            <strong>Article 21. Authorized Capital:</strong> The authorized share
            capital shall be ₹25,00,000 divided into 1,000 shares of ₹2,500 each.
          </p>
          <p>
            <strong>Articles 22 - 30:</strong> Shares may be issued by the Board.
            Certificates will be issued within 90 days. Joint ownership is prohibited.
            Transfers require Board approval. Members may nominate beneficiaries.
            Liability is limited to unpaid share amounts. Shares can be forfeited
            or redeemed. A share register shall be maintained.
          </p>

          <h3 class="chapter-title">CHAPTER V – DEPOSITS, LOANS AND FUNDS</h3>
          <p>
            <strong>Articles 31 - 40:</strong> The Society may accept savings, FDs,
            RDs, and special deposits. It may provide educational, emergency, and
            business loans. The Board or Loan Committee approves applications. Collateral
            may be required. Interest rates are determined by the Board. Reserve,
            Educational Development, and Welfare funds shall be established.
          </p>

          <h3 class="chapter-title">CHAPTER VI – EDUCATIONAL ACTIVITIES</h3>
          <p>
            <strong>Articles 41 - 50:</strong> Authority to establish schools, coaching
            centres, tuition hubs, online portals, web apps, Android/iOS apps, publications,
            libraries, scholarships, and collaborative educational projects.
          </p>

          <h3 class="chapter-title">CHAPTER VII – GENERAL BODY</h3>
          <p>
            <strong>Articles 51 - 60:</strong> The General Body is the supreme authority
            consisting of all voting members. An AGM must be held annually. Special
            meetings can be called. 15 days' notice is required. Quorum is one-third
            of members or 50 (whichever is less). One member, one vote principle applies.
            Powers include electing directors, amending bylaws, and declaring dividends.
          </p>

          <h3 class="chapter-title">CHAPTER VIII – BOARD OF DIRECTORS</h3>
          <p>
            <strong>Articles 61 - 70:</strong> Managed by a Board of 9 directors elected
            for a 5-year term. Members must be in good standing. Disqualifications
            include insolvency or criminal conviction. The first board consists of
            promoters. The Board meets every 2 months with a 7-day notice and a quorum
            of 5 directors.
          </p>

          <h3 class="chapter-title">CHAPTER IX – OFFICE BEARERS</h3>
          <p>
            <strong>Articles 71 - 80:</strong> The Board elects a President and Vice-President,
            and appoints a Secretary and Treasurer. The President presides over meetings.
            The Secretary maintains records, and the Treasurer handles finances. Bearers
            can be removed by a 2/3rd majority of the Board.
          </p>

          <h3 class="chapter-title">CHAPTER X – COMMITTEES</h3>
          <p>
            <strong>Articles 81 - 90:</strong> The Board may form Finance, Educational,
            Technology, Loan, Audit, and Advisory Committees to oversee specific operational
            areas efficiently.
          </p>

          <h3 class="chapter-title">
            CHAPTER XI – EMPLOYEES AND ADMINISTRATION
          </h3>
          <p>
            <strong>Articles 91 - 95:</strong> The Society may appoint teachers and
            staff. The Board determines service conditions. Employees must maintain
            integrity. The Board holds disciplinary powers including suspension and
            termination.
          </p>

          <h3 class="chapter-title">
            CHAPTER XII – ACCOUNTS, SURPLUS AND DIVIDEND
          </h3>
          <p>
            <strong>Article 96 - 99:</strong> Books of accounts shall be maintained.
            The financial year is April 1 to March 31. Annual audits are mandatory.
            Allocations to reserve/welfare funds must be made before dividends.
          </p>
          <p>
            <strong>Article 100. Dividend Distribution:</strong> After making all
            statutory and internal allocations, the Society may declare and distribute
            dividends once every four months at an equal percentage on the paid-up
            capital held by members.
          </p>

          <h3 class="chapter-title">
            CHAPTER XIII – DISPUTES, AMENDMENTS AND DISSOLUTION
          </h3>
          <p>
            <strong>Articles 101 - 110:</strong> Disputes resolved via mediation/arbitration.
            Bylaws amended only by General Body (2/3rd majority required). The Society
            has a common seal. Winding up requires a General Body resolution. Assets
            are disposed of as per law. The Promoter Board manages affairs until the
            first election.
          </p>
        </div>
