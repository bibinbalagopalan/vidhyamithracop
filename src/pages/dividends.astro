<script>
  // Vanilla JS logic for the interactive calculator
  document.addEventListener("DOMContentLoaded", () => {
    const shareInput = document.getElementById("shareCount");
    const invAmountElem = document.getElementById("invAmount");
    const divAmountElem = document.getElementById("divAmount");

    const faceValue = 2500;
    const maxDividendPerShare = 625; // 25% of 2500

    function updateCalculator() {
      let count = parseInt(shareInput.value);

      // Validation constraints
      if (isNaN(count) || count < 1) count = 1;
      if (count > 100) count = 100;

      const totalInv = count * faceValue;
      const totalDiv = count * maxDividendPerShare;

      // Format as Indian Currency (₹)
      invAmountElem.innerText = "₹" + totalInv.toLocaleString("en-IN");
      divAmountElem.innerText = "₹" + totalDiv.toLocaleString("en-IN");
    }

    // Listen for input changes
    shareInput.addEventListener("input", updateCalculator);
    shareInput.addEventListener("blur", () => {
      // Force UI correction if user leaves field with invalid number
      if (shareInput.value < 1) shareInput.value = 1;
      if (shareInput.value > 100) shareInput.value = 100;
      updateCalculator();
    });
  });
</script>
