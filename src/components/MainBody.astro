          </a>
        </li>
      </ul>
    </div>

    <!-- Promoter Login -->
    <div class="sidebar-box login-box">
      <div class="sidebar-header login-header">
        <span class="lang-ml ml-text">പ്രൊമോട്ടർ ലോഗിൻ</span>
        <span class="lang-en">Promoter Login</span>
      </div>
      <div class="login-body">
        <button class="login-btn">
          <span class="lang-ml ml-text"
            >ലോഗിൻ ചെയ്യാൻ ഇവിടെ ക്ലിക്ക് ചെയ്യുക</span
          >
          <span class="lang-en">Click Here to Login</span>
        </button>
      </div>
