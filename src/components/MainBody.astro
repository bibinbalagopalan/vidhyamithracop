---

<div class="content-wrapper">
  <!-- Left Sidebar -->
  <aside class="sidebar">
    <!-- Quick Links -->
    <div class="sidebar-box">
      <div class="sidebar-header">
        <span class="lang-ml ml-text">പ്രധാന ലിങ്കുകൾ</span>
        <span class="lang-en">Quick Links</span>
      </div>
      <ul class="sidebar-list">
        <li>
          <a href="investments">
            <span class="lang-ml ml-text">നിക്ഷേപ പദ്ധതികൾ</span>
            <span class="lang-en">Investment Plans</span>
          </a>
        </li>
        <li>
          <a href="dividends">
            <span class="lang-ml ml-text">ലാഭവിഹിതം</span>
            <span class="lang-en">Dividend Details</span>
          </a>
        </li>
        <li>
          <a href="bylaws">
            <span class="lang-ml ml-text">സൊസൈറ്റി ബൈലോ</span>
            <span class="lang-en">Society Bylaws</span>
          </a>
        </li>
        <li>
          <a href="apply">
            <span class="lang-ml ml-text">നിക്ഷേപ ഫോം ഡൗൺലോഡ്</span>
